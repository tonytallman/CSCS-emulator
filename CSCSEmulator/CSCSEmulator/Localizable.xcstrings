{
  "sourceLanguage": "en",
  "strings": {
    "A BLE connection could not be established.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine BLE-Verbindung konnte nicht hergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer una conexión BLE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'établir une connexion BLE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile stabilire una connessione BLE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE接続を確立できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE 연결을 설정할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível estabelecer uma conexão BLE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法建立 BLE 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立 BLE 連線。"
          }
        }
      }
    },
    "After the emulator is started, the supported metrics cannot be changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Start des Emulators können die unterstützten Messwerte nicht mehr geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez iniciado el emulador, las métricas admitidas no se pueden cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l'émulateur démarré, les mesures prises en charge ne peuvent plus être modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l'avvio dell'emulatore, le metriche supportate non possono essere modificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エミュレーター開始後は、サポートする指標を変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에뮬레이터를 시작한 후에는 지원 측정값을 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que o emulador for iniciado, as métricas suportadas não podem ser alteradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器启动后，支持的指标无法更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器啟動後，支援的指標無法變更。"
          }
        }
      }
    },
    "An unexpected error occurred. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unerwarteter Fehler ist aufgetreten. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se produjo un error inesperado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur inattendue s'est produite. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore imprevisto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないエラーが発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예기치 않은 오류가 발생했습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro inesperado. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生意外错误。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生意外錯誤。請再試一次。"
          }
        }
      }
    },
