    "Choose which metrics this emulator will support. These choices cannot be changed after starting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Messwerte dieser Emulator unterstützt. Diese Auswahl kann nach dem Start nicht geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué métricas admitirá este emulador. No podrás cambiarlas después de iniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les mesures prises en charge par cet émulateur. Ces choix ne peuvent pas être modifiés après le démarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quali metriche supporterà questo emulatore. Non potrai modificarle dopo l'avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエミュレーターがサポートする指標を選択してください。開始後は変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 에뮬레이터가 지원할 측정값을 선택하세요. 시작한 후에는 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quais métricas este emulador suportará. Essas escolhas não podem ser alteradas após iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此模拟器将支持的指标。启动后无法更改这些选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇此模擬器將支援的指標。啟動後無法變更這些選擇。"
          }
        }
      }
    },
