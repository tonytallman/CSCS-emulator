    "Bluetooth is not available on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist auf diesem Gerät nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth no está disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth n'est pas disponible sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth non è disponibile su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではBluetoothを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Bluetooth를 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth não está disponível neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持蓝牙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置不支援藍牙。"
          }
        }
      }
    },
    "Bluetooth is turned off. Enable Bluetooth in Settings to use the emulator.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ist ausgeschaltet. Aktiviere Bluetooth in den Einstellungen, um den Emulator zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth está desactivado. Actívalo en Ajustes para usar el emulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth est désactivé. Activez Bluetooth dans Réglages pour utiliser l'émulateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth è disattivato. Abilita Bluetooth in Impostazioni per usare l'emulatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothがオフです。エミュレーターを使用するには設定でBluetoothを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth가 꺼져 있습니다. 에뮬레이터를 사용하려면 설정에서 Bluetooth를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth está desativado. Ative o Bluetooth em Ajustes para usar o emulador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭。请在设置中启用蓝牙以使用模拟器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙已關閉。請在設定中啟用藍牙以使用模擬器。"
          }
        }
      }
    },
    "Bluetooth permission is turned off. Enable Bluetooth access for %@ in Settings to start the emulator.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bluetooth-Berechtigung ist deaktiviert. Aktiviere den Bluetooth-Zugriff für %@ in den Einstellungen, um den Emulator zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de Bluetooth está desactivado. Activa el acceso a Bluetooth para %@ en Ajustes para iniciar el emulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation Bluetooth est désactivée. Activez l'accès Bluetooth pour %@ dans Réglages pour démarrer l'émulateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso Bluetooth è disattivato. Abilita l'accesso Bluetooth per %@ in Impostazioni per avviare l'emulatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetoothの権限がオフです。エミュレーターを開始するには、設定で %@ のBluetoothアクセスを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 권한이 꺼져 있습니다. 에뮬레이터를 시작하려면 설정에서 %@의 Bluetooth 접근을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de Bluetooth está desativada. Ative o acesso ao Bluetooth para %@ em Ajustes para iniciar o emulador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙权限已关闭。请在设置中为 %@ 启用蓝牙访问以启动模拟器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙權限已關閉。請在設定中為 %@ 啟用藍牙存取以啟動模擬器。"
          }
        }
      }
    },
