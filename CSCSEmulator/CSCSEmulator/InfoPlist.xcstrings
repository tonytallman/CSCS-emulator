        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit via Bluetooth un capteur simulé de vitesse et de cadence cyclistes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornisce tramite Bluetooth un sensore simulato di velocità e cadenza per il ciclismo."
